DB_URL=jdbc:postgresql://localhost:5432/voleyplay
DB_USER=postgres
DB_PASSWORD=establecer-en-el-servidor
ADMIN_USERNAME=admin
ADMIN_PASSWORD=establecer-una-clave-de-al-menos-12-caracteres
FRONTEND_URL=https://voley-play.vercel.app
SESSION_COOKIE_SECURE=true
SESSION_SAME_SITE=lax
PORT=8080
REGISTRATION_MODE=disabled
# Para registro por invitación: REGISTRATION_MODE=invite y un REGISTRATION_CODE de al menos 12 caracteres.
# Registro abierto solo tras elegirlo explícitamente: REGISTRATION_MODE=open.
